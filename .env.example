# Port der Web-App
PORT=8787
# Ordner für Einstellungen und Protokoll (enthält das StreamElements-Token – nicht teilen)
DATA_DIR=./data
# Optional: Passwort fest vorgeben (sonst Ersteinrichtung im Browser)
UELIGHTS_PASSWORD=
# Optional: StreamElements-JWT statt Eingabe in den Einstellungen
SE_JWT=
# Optional: Home-Assistant Long-Lived Access Token
HA_TOKEN=
# Nur für lokale Tests: Login abschalten
UELIGHTS_DISABLE_AUTH=0
LOG_LEVEL=info
